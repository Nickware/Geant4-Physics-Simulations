# Versiones y rutas compartidas por los instaladores.
# Edita este archivo antes de iniciar una instalación para cambiar la pila.

GEANT4_VERSION="11.2.1"
GEANT4_SOURCE_URL="https://github.com/Geant4/geant4/releases/download/v${GEANT4_VERSION}/geant4-v${GEANT4_VERSION}.tar.gz"
GEANT4_GIT_URL="https://github.com/Geant4/geant4.git"
GEANT4_PREFIX="/opt/geant4"

ROOT_VERSION="v6-30-06"
ROOT_SOURCE_URL="https://github.com/root-project/root.git"
ROOT_PREFIX="/opt/root"

INSTALL_WORK_DIR="/var/tmp/geant4-physics-install"
ENVIRONMENT_FILE="/etc/profile.d/geant4-root.sh"
